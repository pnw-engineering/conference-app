        document.addEventListener("DOMContentLoaded", () => {
            const globalModal = document.getElementById('globalTalkModal');
            if (globalModal) {
                globalModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button ? button.getAttribute('data-id') : globalModal.dataset.activeTalkId;

                    if (id && window.location.hash !== `#/talk/${id}`) {
                        window.location.hash = `#/talk/${id}`;
                    }

                    const talkData = getTalkById(id);
                    const metaNode = document.getElementById('modal-talk-meta');
                    const abstractNode = document.getElementById('modal-talk-abstract');
                    const modalFavBtn = document.getElementById('modal-fav-btn');
                    const modalCopyBtn = document.getElementById('modal-copy-btn');

                    const rawAbstract = (talkData && (talkData.abstract || talkData.description || talkData.content)) ||
                        (button ? button.getAttribute('data-abstract') : "") || "";

                    if (talkData) {
                        if (metaNode) metaNode.textContent = `${talkData.day || ''}, ${talkData.start_time || ''}${talkData.location ? '. ' + talkData.location : ''}`;

                        modalFavBtn?.setAttribute('data-id', talkData.id);
                        modalFavBtn?.setAttribute('data-title', talkData.title || '');
                        modalFavBtn?.setAttribute('data-time', talkData.startdatetime || '');
                        modalFavBtn?.setAttribute('data-location', talkData.location || '');

                        modalCopyBtn?.setAttribute('data-id', talkData.id);
                        modalCopyBtn?.setAttribute('data-title', talkData.title || '');
                    } else if (button) {
                        if (metaNode) metaNode.textContent = button.getAttribute('data-meta') || "";

                        modalFavBtn?.setAttribute('data-id', id);
                        modalFavBtn?.setAttribute('data-title', button.getAttribute('data-title') || "");
                        modalFavBtn?.setAttribute('data-time', button.getAttribute('data-time') || button.getAttribute('data-datetime') || "");
                        modalFavBtn?.setAttribute('data-location', button.getAttribute('data-location') || "");

                        modalCopyBtn?.setAttribute('data-id', id);
                        modalCopyBtn?.setAttribute('data-title', button.getAttribute('data-title') || "");
                    }

                    if (abstractNode) {
                        abstractNode.innerHTML = rawAbstract ? rawAbstract : "<p>Abstract not provided.</p>";
                    }

                    updateFavoriteIcons('talk', id);
                });
            }

            const searchInput = document.getElementById("search-input");
            const searchResults = document.getElementById("search-results");

            if (searchInput && searchResults) {
                const clearBtn = document.getElementById("clear-search");
                searchInput.addEventListener("input", (e) => {
                    const query = e.target.value.toLowerCase().trim();
                    searchResults.innerHTML = "";

                    // Toggle visibility of the clear button
                    if (clearBtn) {
                        clearBtn.style.display = query.length > 0 ? "inline-block" : "none";
                    }

                    if (query.length < 2) return;

                    const isAuthorsView = document.getElementById("pills-authors")?.classList.contains("active");
                    let results = [];

                    if (isAuthorsView) {
                        results = Object.values(authorIndex || {}).filter((author) => {
                            if (!author) return false;
                            const fullName = `${author.firstName || author.name || ''} ${author.familyName || ''}`.toLowerCase();
                            const affiliation = (author.affiliation || "").toLowerCase();
                            return fullName.includes(query) || affiliation.includes(query);
                        });
                    } else {
                        results = Object.values(talkIndex || {}).filter((talk) =>
                            talk && (
                                (talk.title && talk.title.toLowerCase().includes(query)) ||
                                (talk.abstract && talk.abstract.toLowerCase().includes(query)) ||
                                (talk.id && talk.id.toString().toLowerCase().includes(query))
                            )
                        );
                    }

                    results.forEach((item) => {
                        const resultItem = document.createElement("button");
                        resultItem.className = "list-group-item list-group-item-action d-flex justify-content-between align-items-center";

                        resultItem.dataset.targetId = item.person_id || item.id;
                        resultItem.dataset.isAuthor = isAuthorsView ? "true" : "false";

                        if (isAuthorsView) {
                            const name = `${item.firstName || item.name || ''} ${item.familyName || ''}`.trim();
                            resultItem.innerHTML = `<span class="text-start">${name}</span>`;
                        } else {
                            resultItem.innerHTML = `<span class="text-start">${item.day || ''} ${item.start_time || ''} ${item.location || ''}: ${item.title || ''}</span>`;
                        }
                        searchResults.appendChild(resultItem);
                    });
                });

                searchResults.addEventListener("click", (e) => {
                    const btn = e.target.closest("button");
                    if (!btn || !searchResults.contains(btn)) return;

                    const targetId = btn.dataset.targetId;
                    const isAuthor = btn.dataset.isAuthor === "true";

                    if (isAuthor) {
                        const element = document.getElementById(`collapse${targetId}`);
                        if (element) {
                            bootstrap.Collapse.getOrCreateInstance(element, { toggle: false }).show();
                            setTimeout(() => {
                                element.closest('.accordion-item')?.scrollIntoView({ behavior: "smooth", block: "start" });
                            }, 300);
                        }
                    } else {
                        const originalBtn = document.querySelector(`button[data-id="${targetId}"][data-bs-target="#globalTalkModal"]`);
                        const modalInstance = bootstrap.Modal.getOrCreateInstance(globalModal);

                        if (originalBtn) {
                            modalInstance.show(originalBtn);
                        } else {
                            globalModal.dataset.activeTalkId = targetId;
                            modalInstance.show();
                        }
                    }
                });
            }

            document.getElementById("clear-search")?.addEventListener("click", () => {
                if (searchInput) {
                    searchInput.value = "";
                    searchInput.dispatchEvent(new Event("input"));
                }
                if (searchResults) {
                    searchResults.innerHTML = "";
                }
            });
        });

        // Sync Hash Routing
        function handleRouting() {
            const hash = window.location.hash;
            if (!hash) return;

            const parts = hash.split('/');
            if (parts.length < 3) return;

            const routeType = parts[1];
            const id = parts[2];

            if (routeType === 'talk') {
                const globalModal = document.getElementById('globalTalkModal');
                if (globalModal) {
                    const originalBtn = document.querySelector(`button[data-id="${id}"][data-bs-target="#globalTalkModal"]`);
                    const modalInstance = bootstrap.Modal.getOrCreateInstance(globalModal);

                    if (originalBtn) {
                        modalInstance.show(originalBtn);
                    } else {
                        globalModal.dataset.activeTalkId = id;
                        modalInstance.show();
                    }
                }
            } else if (routeType === 'session') {
                showScheduleView();

                const element = document.querySelector(`.tab-content .tab-pane:not(#pills-authors) #collapse${id}`);
                if (element) {
                    // Activate parent nested tabs up the DOM tree
                    let current = element.parentElement;
                    while (current && !current.classList.contains('container-fluid')) {
                        if (current.classList.contains('tab-pane')) {
                            const tabTrigger = document.querySelector(`button[data-bs-target="#${current.id}"]`);
                            if (tabTrigger) bootstrap.Tab.getOrCreateInstance(tabTrigger).show();
                        }
                        current = current.parentElement;
                    }

                    bootstrap.Collapse.getOrCreateInstance(element).show();
                    setTimeout(() => {
                        element.closest('.accordion-item')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 300);
                }
            } else if (routeType === 'author') {
                showAuthorsView();

                const element = document.querySelector(`#accordion-authors #collapse${id}`);
                if (element) {
                    bootstrap.Collapse.getOrCreateInstance(element).show();
                    setTimeout(() => {
                        element.closest('.accordion-item')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }, 300);
                }
            }
        }

        window.addEventListener('hashchange', handleRouting);
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(handleRouting, 100);
        });

        document.body.addEventListener('show.bs.collapse', function (event) {
            const collapseEl = event.target;
            if (!collapseEl.id || !collapseEl.id.startsWith('collapse')) return;

            const id = collapseEl.id.replace('collapse', '');

            if (collapseEl.closest('#accordion-authors')) {
                if (window.location.hash !== `#/author/${id}`) window.location.hash = `#/author/${id}`;
            } else {
                if (window.location.hash !== `#/session/${id}`) window.location.hash = `#/session/${id}`;
            }
        });

        document.body.addEventListener('hide.bs.collapse', function (event) {
            const collapseEl = event.target;
            if (!collapseEl.id || !collapseEl.id.startsWith('collapse')) return;

            const id = collapseEl.id.replace('collapse', '');
            if (window.location.hash === `#/session/${id}` || window.location.hash === `#/author/${id}`) {
                window.location.hash = '';
            }
        });

        // QR Scanner Handlers
        let html5QrScanner = null;

        document.getElementById('btn-scan-qr')?.addEventListener('click', () => {
            const qrModalEl = document.getElementById('qrScannerModal');
            if (qrModalEl) {
                const scannerModal = new bootstrap.Modal(qrModalEl);
                scannerModal.show();
            }
        });

        document.getElementById('qrScannerModal')?.addEventListener('shown.bs.modal', () => {
            html5QrScanner = new Html5Qrcode("qr-video-reader");
            const config = { fps: 10, qrbox: { width: 250, height: 250 } };

            html5QrScanner.start(
                { facingMode: "environment" },
                config,
                (decodedText) => {
                    try {
                        const url = decodedText.includes('#') ? new URL(decodedText) : null;
                        const hashValue = url ? url.hash : decodedText;

                        if (hashValue && hashValue.startsWith('#/')) {
                            html5QrScanner.stop().then(() => {
                                const qrModalEl = document.getElementById('qrScannerModal');
                                if (qrModalEl) bootstrap.Modal.getInstance(qrModalEl)?.hide();
                                window.location.hash = hashValue;
                            });
                        }
                    } catch (err) {
                        console.error("Malformed QR data payload parsed.", err);
                    }
                },
                () => { }
            ).catch(err => console.error("Camera access failed or rejected by system settings.", err));
        });

        document.getElementById('qrScannerModal')?.addEventListener('hide.bs.modal', () => {
            if (html5QrScanner && html5QrScanner.isScanning) {
                html5QrScanner.stop().catch(err => console.error("Error killing video track context.", err));
            }
        });

        async function copyToClipboardFallback(textToCopy, btn) {
            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(textToCopy);
                } else {
                    const textarea = document.createElement("textarea");
                    textarea.value = textToCopy;
                    textarea.style.position = "fixed";
                    textarea.style.opacity = "0";
                    document.body.appendChild(textarea);
                    textarea.select();
                    document.execCommand("copy");
                    document.body.removeChild(textarea);
                }

                const img = btn?.querySelector('img');
                if (img) {
                    const originalSrc = img.src;
                    img.src = "./link.svg";
                    setTimeout(() => {
                        img.src = originalSrc;
                    }, 1000);
                }
            } catch (err) {
                console.error('Clipboard copy fallback failed:', err);
            }
        }

        document.body.addEventListener('click', async (e) => {
            const btn = e.target.closest('.share-btn, .copy-btn');
            if (!btn) return;

            e.preventDefault();
            e.stopPropagation();

            const route = btn.dataset.route;
            const id = btn.dataset.id;
            if (!route || !id) return;

            let plainTextTitle = btn.dataset.title || "";
            let shareText = "";

            if (route === "talk") {
                const talkData = getTalkById(id);
                plainTextTitle = plainTextTitle || talkData?.title || "";
                const rawAbstract = (talkData && (talkData.abstract || talkData.description || talkData.content)) || btn.dataset.abstract || "";
                const plainAbstract = convertAbstractToPlainText(rawAbstract);

                if (plainTextTitle && plainAbstract) {
                    shareText = `${plainTextTitle}\n\n${plainAbstract}`;
                } else {
                    shareText = plainTextTitle || plainAbstract;
                }
            } else if (route === "author") {
                if (!plainTextTitle) {
                    const author = (authorIndex || {})[id] || Object.values(authorIndex || {}).find(a => String(a?.person_id || a?.id) === String(id));
                    plainTextTitle = author ? `${author.firstName || author.name || ''} ${author.familyName || ''}`.trim() : "";
                }
                shareText = plainTextTitle;
            } else {
                shareText = plainTextTitle;
            }

            const shareUrl = `${window.location.origin}${window.location.pathname}#/${route}/${id}`;
            const fullSharePayloadText = shareText ? `${shareText}\n\n${shareUrl}` : shareUrl;

            const shareData = {
                title: plainTextTitle || "{{conference_title}}",
                text: shareText
            };

            try {
                const parsedUrl = new URL(shareUrl, window.location.href);
                if (parsedUrl.protocol === 'http:' || parsedUrl.protocol === 'https:') {
                    shareData.url = parsedUrl.href;
                } else {
                    shareData.text = fullSharePayloadText;
                }
            } catch (err) {
                shareData.text = fullSharePayloadText;
            }

            if (navigator.share) {
                try {
                    await navigator.share(shareData);
                } catch (err) {
                    if (err.name !== "AbortError") {
                        console.error('Web Share failed, attempting clipboard fallback:', err);
                        await copyToClipboardFallback(fullSharePayloadText, btn);
                    }
                }
            } else {
                await copyToClipboardFallback(fullSharePayloadText, btn);
            }
        });
    </script>
