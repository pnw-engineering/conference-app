                ${dayTimeLoc}. <strong>${talk.title}</strong>
            </button>
            <button type="button" class="btn btn-link p-0 text-muted ms-2 share-btn" data-route="talk" data-id="${talk.id}" data-title="${safeTitle}" title="Share Talk">
                <img class="share-icon" src="${shareIconSrc}" alt="Share" />
            </button>
            <button type="button" class="fav-btn" data-type="talk" data-id="${talk.id}" data-title="${safeTitle}" title="Favorite">
                <img src="./star.svg" alt="Favorite" />
            </button>
        </div>
    `;
                });
                bodyZone.innerHTML = html;

                author.presentations.forEach((talkId) => {
                    updateFavoriteIcons("talk", talkId);
