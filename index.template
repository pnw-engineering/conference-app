<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{conference_title}}</title>
    <meta name="theme-color" content="#ecb73c" />
    <!-- <link rel="manifest" href="manifest.json" /> -->
    <link href="bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="bootstrap-icons.min.css" />

    <!-- <link rel="apple-touch-icon" href="ios/apple-icon-180.png" /> -->
    <meta name="apple-touch-fullscreen" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="{{conference_title}}" />

    <style>
        .fav-btn {
            cursor: pointer;
            padding: 0;
            margin-left: 8px;
            border: none;
            background: none;
            color: #ffc107;
        }

        body {
            padding-bottom: 70px;
        }

        .nav-item_active {
            color: #ecb73c !important;
        }

        .nav-link-btn.active-nav {
            color: #ecb73c !important;
            font-weight: bold;
            transform: scale(1.1);
            transition: all 0.2s ease-in-out;
        }

        .pseudo-btn::before {
            content: attr(data-time);
        }

        .accordion-item {
            scroll-margin-top: 240px;
        }

        .accordion-button {
            padding-right: 0.5rem !important;
        }

        .accordion-button::after {
            transform: scale(0.85);
        }

        .accordion-button:disabled {
            background-color: #f8f9fa;
            /* Light gray background */
            color: #6c757d;
            /* Gray text (text-muted color) */
            cursor: not-allowed;
            /* Shows a blocked cursor on hover */
            box-shadow: none;
            /* Removes the active blue border glow */
        }

        /* Hide the arrow toggle icon */
        .accordion-button:disabled::after {
            background-image: none;
        }

        ol.affiliations {
            list-style: none;
            padding: 0;
            margin: 0;
            display: inline;
            counter-reset: aff-counter;
        }

        ol.affiliations li {
            display: inline;
            counter-increment: aff-counter;
        }

        ol.affiliations li::before {
            content: counter(aff-counter) ". ";
            font-weight: 500;
        }

        /* Sub-tab styling for Morning/Afternoon */
        .sub-nav-pills .nav-link {
            font-size: 0.875rem;
            padding: 0.25rem 0.85rem;
            border-radius: 20px;
            color: #6c757d;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
        }

        .sub-nav-pills .nav-link.active {
            color: #000;
            background-color: #e9ecef;
            border-color: #ced4da;
            font-weight: 600;
        }

        .action-panel {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 40px;
            /* Fixed width ensures consistent centering */
        }

        .action-panel .btn,
        .action-panel .fav-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            padding: 0;
            margin: 0;
            /* Overrides .fav-btn { margin-left: 8px; } */
            border: none;
            background: none;
        }

        .action-panel img,
        .action-panel .share-icon {
            width: 20px;
            height: 20px;
            object-fit: contain;
            display: block;
        }
    </style>
    <script src="html5-qrcode.min.js" type="text/javascript"></script>
</head>

<body class="pb-70">
    <!-- Main Content View -->
    <div id="app-main-content" class="container-fluid">
        <!-- START OF STICKY HEADER CONTAINER -->
        <div class="sticky-top bg-white pt-3 pb-2 mb-3 border-bottom" style="top: 0; z-index: 1020">
            <h3 class="mb-3">{{conference_title}}</h3>
            <div class="mb-3">
                <div class="input-group">
                    <input type="text" id="search-input" class="form-control form-control-lg"
                        placeholder="Search talks by title or abstract..." autocomplete="off" />
                    <button class="btn btn-small" type="button" id="clear-search" style="display: none;">
                        <img src="./x.svg" alt="X" />
                    </button>
                    <!-- QR Code Scan Trigger Button -->
                    <button class="btn btn-outline" type="button" id="btn-scan-qr" title="Scan Badge QR">
                        <img src="./qr-code-scan.svg" alt="QRcode" />
                    </button>
                </div>
                <div id="search-results" class="list-group mt-2" style="max-height: 300px; overflow-y: auto"></div>
            </div>
            {% set days = sessions.keys() %}
            <ul class="nav nav-pills flex-nowrap overflow-x-auto text-nowrap mb-3" id="pills-tab" role="tablist">
                {% for day in days %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link{% if loop.first %} active{% endif %}" id="pills-{{day}}-tab"
                        data-bs-toggle="pill" data-bs-target="#pills-{{day}}" type="button" role="tab"
                        aria-controls="pills-{{day}}" aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
                        {{day}}
                    </button>
                </li>
                {% endfor %}
            </ul>
        </div>
        <!-- END OF STICKY HEADER CONTAINER -->

        <div class="tab-content" id="pills-tabContent">
            <!-- Schedule View -->
            {% for day in days %}
            <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="pills-{{day}}" role="tabpanel"
                aria-labelledby="pills-{{day}}-tab" tabindex="0">

                <!-- Morning / Afternoon Sub Tabs -->
                <ul class="nav nav-pills sub-nav-pills gap-2 mb-3" id="pills-{{day}}-period-tab" role="tablist">
                    {% for period in ['Morning', 'Afternoon'] %}
                    {% set period_slug = period | lower %}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link{% if loop.first %} active{% endif %}"
                            id="pills-{{day}}-{{period_slug}}-tab" data-bs-toggle="pill"
                            data-bs-target="#pills-{{day}}-{{period_slug}}" type="button" role="tab"
                            aria-controls="pills-{{day}}-{{period_slug}}"
                            aria-selected="{% if loop.first %}true{% else %}false{% endif %}">
                            {{period}}
                        </button>
                    </li>
                    {% endfor %}
                </ul>

                <!-- Sub Tab Content -->
                <div class="tab-content" id="pills-{{day}}-period-tabContent">
                    {% for period in ['Morning', 'Afternoon'] %}
                    {% set period_slug = period | lower %}
                    <div class="tab-pane fade{% if loop.first %} show active{% endif %}"
                        id="pills-{{day}}-{{period_slug}}" role="tabpanel"
                        aria-labelledby="pills-{{day}}-{{period_slug}}-tab" tabindex="0">

                        <div class="accordion" id="accordion-{{day}}-{{period_slug}}">
                            {% set period_sessions = sessions[day][period] if (sessions[day] is defined and
                            sessions[day][period] is defined) else [] %}
                            {% for session in period_sessions %}
                            {% if session["entryType"] == "Session" %}
                            <div class="accordion-item">
                                <h2 class="accordion-header d-flex justify-content-between align-items-center">
                                    <!-- Session details toggle button -->
                                    <button class="accordion-button collapsed flex-grow-1" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#collapse{{session.id}}"
                                        aria-expanded="false" aria-controls="collapse{{session.id}}" {% if
                                        session["talks"]|length==0 %}disabled{% endif %}>
                                        <div class="pe-2">
                                            <span class="fw-bold d-block mb-1"
                                                style="line-height: 1.3">{{session.title}}</span>
                                            <small class="text-muted fw-normal">{{session.start_time}}.
                                                {{session.location}}</small>
                                        </div>
                                    </button>

                                    <!-- Action Panel -->
                                    <!-- Action Panel -->
                                    <div class="action-panel border-start py-1 bg-white" style="z-index: 2">
                                        <button type="button" class="fav-btn mb-1" data-type="session"
                                            data-id="{{session.id}}" data-title="{{session.slotTitle}}"
                                            data-time="{{session.startdatetime}}" data-location="{{session.location}}"
                                            title="Favorite">
                                            <img src="./star.svg" alt="Favorite" />
                                        </button>

                                        <button type="button" class="btn btn-link share-btn" data-route="session"
                                            data-id="{{session.id}}" data-title="{{session.slotTitle}}"
                                            title="Share Session">
                                            <img class="share-icon" src="./share.svg" alt="Share" />
                                        </button>
                                    </div>
                                </h2>
                                <div id="collapse{{session.id}}" class="accordion-collapse collapse"
                                    data-bs-parent="#accordion-{{day}}-{{period_slug}}">
                                    <div class="accordion-body">
                                        {% for talk in session['talks'] %}
                                        <!-- Cleaned Talk Entry -->
                                        <div class="d-flex align-items-center mb-2">
                                            <button type="button" class="btn btn-light text-start pseudo-btn"
                                                data-bs-toggle="modal" data-bs-target="#globalTalkModal"
                                                data-id="{{talk.id}}" data-time="{{talk.start_time}}. ">
                                                {{talk.title}}
                                            </button>
                                            <button type="button" class="btn btn-link p-0 text-muted ms-2 share-btn"
                                                data-route="talk" data-id="{{talk.id}}" title="Share Talk">
                                                <img class="share-icon" src="./share.svg" alt="Share" />
                                            </button>
                                            <button type="button" class="fav-btn" data-type="talk" data-id="{{talk.id}}"
                                                title="Favorite">
                                                <img src="./star.svg" alt="Favorite" />
                                            </button>
                                        </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                            {% elif session["entryType"] == "Contribution" %}
                            <div class="d-flex align-items-center mb-2">
                                <button type="button" class="btn btn-light text-start pseudo-btn" data-bs-toggle="modal"
                                    data-bs-target="#globalTalkModal" data-time="{{session.start_time}}. "
                                    data-title="{{session.title}}"
                                    data-meta="{{session.day}}, {{session.start_time}}. {{session.location}}"
                                    data-id="{{session.id}}" data-location="{{session.location}}"
                                    data-datetime="{{session.startdatetime}}"
                                    data-abstract="{{ session.abstract | default('') | e }}">
                                    {{session.title}}
                                </button>
                                <button type="button" class="btn btn-link p-0 text-muted ms-2 share-btn"
                                    data-route="talk" data-id="{{session.id}}" data-title="{{session.title}}"
                                    title="Share Talk">
                                    <img class="share-icon" src="./share.svg" alt="Share" />
                                </button>
                                <button type="button" class="fav-btn" data-type="talk" data-id="{{session.id}}"
                                    data-title="{{session.title}}" data-time="{{session.startdatetime}}"
                                    data-location="{{session.location}}" title="Favorite">
                                    <img src="./star.svg" alt="Favorite" />
                                </button>
                            </div>
                            {% else %}

                            <div class="card rounded-0">
                                <div class="card-body">
                                    <h6 class="card-title">{{session.title}}</h6>
                                    <h7 class="card-subtitle mb-2 text-muted">{{session.start_time}}
                                        {{session.location}}</h7>
                                </div>
                            </div>

                            {% endif %}
                            {% else %}
                            <div class="text-center py-4 text-muted">
                                <small>No {{period | lower}} sessions scheduled for {{day}}.</small>
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}

            <!-- Authors View -->
            <div class="tab-pane fade" id="pills-authors" role="tabpanel" aria-labelledby="pills-authors-tab"
                tabindex="0">
                <div class="accordion" id="accordion-authors">
                    <div class="text-center py-5" id="authors-tab-loader">
                        <div class="spinner-border text-warning" role="status">
                            <span class="visually-hidden">Loading authors...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- View for Favorites -->
    <div id="app-favorites-view" class="container-fluid pt-3" style="display: none">
        <div class="d-flex justify-content-between align-items-center px-2 mb-4">
            <h3 class="m-0">Favorites</h3>
            <!-- Export Schedule Trigger Button -->
            <button type="button" id="btn-export-favorites" class="btn btn-link btn-sm d-flex align-items-center gap-1">
                <img id="share-icon-img" class="share-icon" src="./share.svg" alt="Share" />
            </button>
        </div>
        <div id="favorites-list"></div>
    </div>

    <!-- View for Map -->
    <div id="app-map-view" class="container-fluid pt-3" style="display: none">
        <div class="px-2 mb-4">
            <h3 class="m-0">Venue Map</h3>
        </div>
        <div class="text-center py-3">
            <img src="./map.svg" class="img-fluid" alt="Venue Map" style="max-width: 100%; height: auto;" />
        </div>
    </div>

    <!-- Bottom Navigation Bar -->
    <nav class="fixed-bottom bg-white border-top shadow-sm" style="height: 60px">
        <div class="container d-flex justify-content-around align-items-center">
            <a href="#" id="btn-nav-schedule" class="text-decoration-none text-muted text-center nav-link-btn">
                <img src="./calendar3.svg" class="fs-4" alt="Calendar" />
                <div style="font-size: 10px">Schedule</div>
            </a>
            <a href="#" id="btn-nav-authors" class="text-decoration-none text-muted text-center nav-link-btn">
                <img src="./person.svg" class="fs-4" alt="Authors" />
                <div style="font-size: 10px">Authors</div>
            </a>
            <a href="#" id="btn-nav-favorites" class="text-decoration-none text-muted text-center nav-link-btn">
                <img src="./star.svg" class="fs-4" alt="Star" />
                <div style="font-size: 10px">Favorites</div>
            </a>
            <!-- Added Map Button -->
            <a href="#" id="btn-nav-map" class="text-decoration-none text-muted text-center nav-link-btn">
                <img src="./map.svg" class="fs-4" alt="Map" />
                <div style="font-size: 10px">Map</div>
            </a>
        </div>
    </nav>

    <!-- Global Modals Container -->
    <div id="global-modals">
        <div class="modal fade" id="globalTalkModal" tabindex="-1" aria-labelledby="globalTalkModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header d-flex justify-content-between align-items-center">
                        <span id="modal-talk-meta"></span>
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" id="modal-copy-btn" class="btn btn-link p-0 text-muted share-btn"
                                data-route="talk" data-id="" data-title="" title="Share Talk">
                                <img class="share-icon" src="./share.svg" alt="Share" />
                            </button>
                            <button type="button" id="modal-fav-btn" class="fav-btn" data-type="talk" data-id=""
                                title="Favorite">
                                <img src="./star.svg" alt="Favorite" />
                            </button>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                    <div class="modal-body" id="modal-talk-abstract"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="qrScannerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Scan Participant Badge</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body bg-dark p-0 position-relative">
                    <div id="qr-video-reader" style="width: 100%"></div>
                </div>
            </div>
        </div>
    </div>
    <script src="bootstrap.bundle.min.js"></script>

    <script>
        // Platform detection and share icon setup
        const isAppleDevice = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
        const shareIconSrc = isAppleDevice ? "./box-arrow-up.svg" : "./share.svg";

        // Global State & Pre-serialized JSON setup
        // Dynamic storage key scoped to the specific conference year/title
        const CONFERENCE_TITLE = {{ conference_title | tojson }};
        const STORAGE_KEY = `conference_favorites_${CONFERENCE_TITLE.toLowerCase().replace(/[^a-z0-9]/g, '_')}`;

        // Clean up favorites from past conferences
        // Object.keys(localStorage).forEach((key) => {
        //     if (key.startsWith("conference_favorites_") && key !== STORAGE_KEY) {
        //         localStorage.removeItem(key);
        //     }
        // });

        let favorites = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}") || {};
        let talkIndex = {{ talks | default ('{}') | safe }};
        let authorIndex = {{ authors | default ('{}') | safe }};

        function getTalkById(id) {
            if (!id || !talkIndex) return null;
            if (talkIndex[id]) return talkIndex[id];
            if (talkIndex[String(id)]) return talkIndex[String(id)];
            const values = Array.isArray(talkIndex) ? talkIndex : Object.values(talkIndex);
            return values.find(t => t && String(t.id) === String(id)) || null;
        }

        function updatePlatformIcons() {
            document.querySelectorAll(".share-icon").forEach((img) => {
                img.src = shareIconSrc;
            });
        }

        function convertAbstractToPlainText(htmlString) {
            if (!htmlString) return "";
            const doc = new DOMParser().parseFromString(htmlString, 'text/html');
            doc.querySelectorAll('p, div, br').forEach((el) => {
                if (el.tagName.toLowerCase() === 'br') {
                    el.replaceWith('\n');
                } else {
                    el.appendChild(doc.createTextNode('\n'));
                }
            });
            return doc.body.textContent
                .split('\n')
                .map((line) => line.trim())
                .filter((line) => line.length > 0)
                .join('\n');
        }

        function setActiveNav(btnId) {
            const scheduleBtn = document.getElementById("btn-nav-schedule");
            const authorsBtn = document.getElementById("btn-nav-authors");
            const favsBtn = document.getElementById("btn-nav-favorites");
            const mapBtn = document.getElementById("btn-nav-map");

            if (scheduleBtn) scheduleBtn.classList.remove("active-nav");
            if (authorsBtn) authorsBtn.classList.remove("active-nav");
            if (favsBtn) favsBtn.classList.remove("active-nav");
            if (mapBtn) mapBtn.classList.remove("active-nav");

            const activeBtn = document.getElementById(btnId);
            if (activeBtn) activeBtn.classList.add("active-nav");
        }

        function showScheduleView() {
            const mainContent = document.getElementById("app-main-content");
            const favsZone = document.getElementById("app-favorites-view");
            const mapView = document.getElementById("app-map-view");
            const pillsTab = document.getElementById("pills-tab");
            const searchInput = document.getElementById("search-input");

            if (mainContent) mainContent.style.display = "block";
            if (favsZone) favsZone.style.display = "none";
            if (mapView) mapView.style.display = "none";
            if (pillsTab) pillsTab.style.display = "flex";

            const authorsPane = document.getElementById("pills-authors");
            if (authorsPane && authorsPane.classList.contains("active")) {
                authorsPane.classList.remove("show", "active");

                // 1. Re-activate current Day pane
                const activeDayBtn = document.querySelector('#pills-tab button.nav-link.active') || document.querySelector('#pills-tab button.nav-link');
                if (activeDayBtn) {
                    const targetSelector = activeDayBtn.getAttribute("data-bs-target");
                    const targetPane = targetSelector ? document.querySelector(targetSelector) : null;
                    if (targetPane) {
                        targetPane.classList.add("show", "active");

                        // 2. Re-activate active Morning/Afternoon session pane inside this day
                        const activeSessionBtn = targetPane.querySelector('.nav-link.active, .btn.active') || targetPane.querySelector('.nav-link, .btn');
                        if (activeSessionBtn) {
                            const sessionSelector = activeSessionBtn.getAttribute("data-bs-target") || activeSessionBtn.getAttribute("href");
                            const sessionPane = sessionSelector ? targetPane.querySelector(sessionSelector) || document.querySelector(sessionSelector) : null;
                            if (sessionPane) {
                                sessionPane.classList.add("show", "active");
                            }
                        }
                    }
                }
            }

            if (searchInput) searchInput.placeholder = "Search talks by title or abstract...";
            setActiveNav("btn-nav-schedule");
        }

        function showAuthorsView() {
            const mainContent = document.getElementById("app-main-content");
            const favsZone = document.getElementById("app-favorites-view");
            const mapView = document.getElementById("app-map-view");
            const pillsTab = document.getElementById("pills-tab");
            const searchInput = document.getElementById("search-input");

            if (mainContent) mainContent.style.display = "block";
            if (favsZone) favsZone.style.display = "none";
            if (mapView) mapView.style.display = "none";
            if (pillsTab) pillsTab.style.display = "none";

            // Only target top-level day panes directly inside #pills-tabContent
            document.querySelectorAll("#pills-tabContent > .tab-pane").forEach((pane) => {
                pane.classList.remove("show", "active");
            });

            const authorsPane = document.getElementById("pills-authors");
            if (authorsPane) authorsPane.classList.add("show", "active");

            if (searchInput) searchInput.placeholder = "Search authors...";
            renderAuthorsSkeleton();
            setActiveNav("btn-nav-authors");
        }

        function showFavoritesView() {
            const mainContent = document.getElementById("app-main-content");
            const favsZone = document.getElementById("app-favorites-view");
            const mapView = document.getElementById("app-map-view");

            if (mainContent) mainContent.style.display = "none";
            if (favsZone) favsZone.style.display = "block";
            if (mapView) mapView.style.display = "none";
            renderFavoritesList();
            setActiveNav("btn-nav-favorites");
        }

        function showMapView() {
            const mainContent = document.getElementById("app-main-content");
            const favsZone = document.getElementById("app-favorites-view");
            const mapView = document.getElementById("app-map-view");

            if (mainContent) mainContent.style.display = "none";
            if (favsZone) favsZone.style.display = "none";
            if (mapView) mapView.style.display = "block";
            setActiveNav("btn-nav-map");
        }

        function renderFavoritesList() {
            const listContainer = document.getElementById("favorites-list");
            if (!listContainer) return;

            favorites = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}") || {};
            const keys = Object.keys(favorites);

            if (keys.length === 0) {
                listContainer.innerHTML = '<div class="text-center py-4 text-muted"><p class="mb-0">No favorites saved yet.</p><small>Tap the star icon on any talk or session to save it here.</small></div>';
                return;
            }

            let favItems = keys.map((key) => ({
                key: key,
                data: favorites[key] || {},
            }));

            favItems.sort((a, b) => {
                const timeA = a.data.time ? new Date(a.data.time).getTime() : 0;
                const timeB = b.data.time ? new Date(b.data.time).getTime() : 0;
                return timeA - timeB;
            });

            listContainer.innerHTML = "";

            favItems.forEach((item) => {
                const [type, id] = item.key.split(":");
                const data = item.data;
                const isFav = !!favorites[`${type}:${id}`];
                const starImg = isFav ? "./star-fill.svg" : "./star.svg";

                const cardElement = document.createElement("div");
                cardElement.className = "card rounded-0 mb-2 shadow-sm";

                let content = "";
                let formattedTime = "";

                if (data.time) {
                    const dateObj = new Date(data.time);
                    if (!isNaN(dateObj.getTime())) {
                        formattedTime =
                            dateObj.toLocaleDateString("en-US", {
                                weekday: "short",
                                month: "short",
                                day: "numeric",
                            }) +
                            " " +
                            dateObj.toLocaleTimeString("en-US", {
                                hour: "2-digit",
                                minute: "2-digit",
                            });
                    } else {
                        formattedTime = data.time;
                    }
                }

                let modalAttributes = type === "talk" ? `role="button" tabindex="0" data-bs-toggle="modal" data-bs-target="#globalTalkModal" data-id="${id}"` : "";

                content += `<div class="flex-grow-1 text-start" ${modalAttributes}>`;
                content += `  <h6 class="${type === "talk" ? "mb-1 text-primary fw-bold" : "mb-1 text-success fw-bold"}">${data.title || 'Untitled'}</h6>`;

                if (formattedTime) {
                    content += `  <p class="mb-0 small text-muted"><img src="./calendar.svg" alt="Calendar" style="width: 14px; margin-right: 4px;" /> ${formattedTime}</p>`;
                }
                if (data.location) {
                    content += `  <p class="mb-0 small text-muted"><img src="./geo-alt.svg" alt="Location" style="width: 14px; margin-right: 4px;" /> ${data.location}</p>`;
                }
                content += `</div>`;

                content += `<div>`;
                content += `  <button type="button" class="fav-btn btn btn-link p-0 ms-3"
                            data-type="${type}"
                            data-id="${id}"
                            data-time="${data.time || ""}"
                            data-location="${data.location || ""}"
                            data-title="${(data.title || "").replace(/"/g, '&quot;')}"
                            title="Favorite">
                            <img src="${starImg}" alt="Favorite" />
                          </button>`;
                content += `</div>`;

                const cardBody = document.createElement("div");
                cardBody.className = "card-body d-flex justify-content-between align-items-center p-3";

                cardBody.innerHTML = content;
                cardElement.appendChild(cardBody);
                listContainer.appendChild(cardElement);
            });
        }

        function updateFavoriteIcons(type, id) {
            const key = `${type}:${id}`;
            const isFav = !!favorites[key];
            const buttons = document.querySelectorAll(
                `.fav-btn[data-type="${type}"][data-id="${id}"]`,
            );
            buttons.forEach((btn) => {
                const img = btn.querySelector("img");
                if (img) {
                    img.src = isFav ? "./star-fill.svg" : "./star.svg";
                }
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            showScheduleView();
            updatePlatformIcons();

            document.querySelectorAll(".fav-btn").forEach((btn) => {
                updateFavoriteIcons(btn.dataset.type, btn.dataset.id);
            });

            const searchInput = document.getElementById("search-input");
            const tabElements = document.querySelectorAll(
                '#pills-tab button[data-bs-toggle="pill"]',
            );

            tabElements.forEach((tab) => {
                tab.addEventListener("shown.bs.tab", function () {
                    if (searchInput) {
                        searchInput.placeholder = "Search talks by title or abstract...";
                    }
                });
            });

            // Global Favorite Click Handling
            document.body.addEventListener("click", (e) => {
                const btn = e.target.closest(".fav-btn");
                if (!btn) return;

                const id = btn.dataset.id;
                const type = btn.dataset.type;
                if (!id || !type) return;

                const key = `${type}:${id}`;
                const talkData = getTalkById(id);

                let labelText = btn.dataset.title;
                if (!labelText && type === "talk" && talkData) {
                    labelText = talkData.title;
                }
                if (!labelText) {
                    const parent = btn.closest(".accordion-header, .d-flex, .modal-content");
                    if (parent) {
                        const titleEl = parent.querySelector(".fw-bold, button.pseudo-btn, h6, strong");
                        if (titleEl) labelText = titleEl.innerText.trim();
                    }
                }
                if (!labelText) labelText = "Untitled Item";

                labelText = labelText.split("\n")[0];

                if (favorites[key]) {
                    delete favorites[key];
                } else {
                    favorites[key] = {
                        title: labelText,
                        time: btn.dataset.time || (talkData ? talkData.startdatetime : ""),
                        location: btn.dataset.location || (talkData ? talkData.location : ""),
                        timestamp: new Date().toISOString(),
                    };
                }

                localStorage.setItem(STORAGE_KEY, JSON.stringify(favorites));
                updateFavoriteIcons(type, id);

                const favsView = document.getElementById("app-favorites-view");
                if (favsView && favsView.style.display !== "none") {
                    renderFavoritesList();
                }
            });

            // Bottom Navigation Listeners
            document.getElementById("btn-nav-schedule")?.addEventListener("click", (e) => {
                e.preventDefault();
                showScheduleView();
            });

            document.getElementById("btn-nav-authors")?.addEventListener("click", (e) => {
                e.preventDefault();
                showAuthorsView();
            });

            document.getElementById("btn-nav-favorites")?.addEventListener("click", (e) => {
                e.preventDefault();
                showFavoritesView();
            });

            document.getElementById("btn-nav-map")?.addEventListener("click", (e) => {
                e.preventDefault();
                showMapView();
            });

            document.getElementById("btn-export-favorites")?.addEventListener("click", async () => {
                const storedFavs = JSON.parse(localStorage.getItem(STORAGE_KEY) || "{}") || {};
                const keys = Object.keys(storedFavs);
                const talkKeys = keys.filter((key) => key.startsWith("talk:"));

                if (talkKeys.length === 0) {
                    alert("You don't have any favorited talks to export yet!");
                    return;
                }

                let compiledTalks = talkKeys.map((key) => {
                    const [_, id] = key.split(":");
                    const talkData = getTalkById(id);
                    const favItem = storedFavs[key] || {};

                    const rawAbstract = talkData ? (talkData.abstract || talkData.description || talkData.content) : "";

                    return {
                        time: talkData ? talkData.startdatetime : favItem.time || "",
                        metaTime: talkData ? `${talkData.day || ''}, ${talkData.start_time || ''}` : "",
                        location: talkData ? talkData.location : favItem.location || "",
                        formattedContent: rawAbstract
                            ? convertAbstractToPlainText(rawAbstract)
                            : `📌 ${favItem.title || 'Talk'}`
                    };
                });

                compiledTalks.sort((a, b) => new Date(a.time) - new Date(b.time));

                let exportText = "{{conference_title}} - My Saved Talks & Abstracts\n";
                exportText += "========================================\n\n";

                compiledTalks.forEach((talk) => {
                    exportText += talk.formattedContent + "\n";
                    if (talk.metaTime) exportText += `⏰ SCHEDULED TIME: ${talk.metaTime}\n`;
                    if (talk.location) exportText += `📍 LOCATION: ${talk.location}\n`;
                    exportText += "\n----------------------------------------\n\n";
                });

                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: "My {{conference_title}} Presentation Abstracts",
                            text: exportText
                        });
                    } catch (err) {
                        if (err.name !== "AbortError") {
                            console.error("Native OS web share pipeline failed:", err);
                        }
                    }
                } else {
                    await copyToClipboardFallback(exportText, document.getElementById("btn-export-favorites"));
                }
            });
        });

        // On-Demand Author Rendering
        let authorsRendered = false;

        function renderAuthorsSkeleton() {
            if (authorsRendered) return;
            const container = document.getElementById("accordion-authors");
            if (!container) return;

            const fragment = document.createDocumentFragment();

            const sortedAuthors = Object.values(authorIndex || {})
                .filter((author) => {
                    if (!author) return false;
                    const fullName = (author.firstName || author.familyName)
                        ? `${author.firstName || ''} ${author.familyName || ''}`.trim()
                        : (author.name || author.full_name || '').trim();
                    return fullName.length > 0;
                })
                .sort((a, b) => {
                    const lastNameCompare = (a?.familyName || a?.name || "").localeCompare(b?.familyName || b?.name || "");
                    if (lastNameCompare !== 0) return lastNameCompare;
                    return (a?.firstName || "").localeCompare(b?.firstName || "");
                });

            sortedAuthors.forEach((author) => {
                const fullName = (author.firstName || author.familyName)
                    ? `${author.firstName || ''} ${author.familyName || ''}`.trim()
                    : (author.name || author.full_name || '').trim();
                const authorId = author.person_id || author.id;
                if (!authorId) return;

                const item = document.createElement("div");
                item.className = "accordion-item";
                item.setAttribute("id", `author-row-${authorId}`);
                item.setAttribute("data-id", authorId);
                item.setAttribute("data-name", fullName);

                item.innerHTML = `
    <h2 class="accordion-header d-flex justify-content-between align-items-center">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
            data-bs-target="#collapse${authorId}" aria-expanded="false"
            aria-controls="collapse${authorId}" data-author-id="${authorId}">
            <div class="text-start">
                <strong>${fullName}</strong><br />
                <small class="text-muted fw-normal">${author.affiliation || ''}</small>
            </div>
        </button>
        <button type="button" class="btn btn-link p-0 text-muted me-3 share-btn" data-route="author" data-id="${authorId}" data-title="${fullName}" title="Share Author">
            <img class="share-icon" src="${shareIconSrc}" alt="Share" />
        </button>
    </h2>
    <div id="collapse${authorId}" class="accordion-collapse collapse"
        data-bs-parent="#accordion-authors">
        <div class="accordion-body" id="author-body-${authorId}">
            <div class="text-center py-2">
                <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
            </div>
        </div>
    </div>
`;
                fragment.appendChild(item);
            });

            container.innerHTML = "";
            container.appendChild(fragment);
            authorsRendered = true;
        }

        // Lazy-load author details
        document.getElementById("accordion-authors")?.addEventListener("show.bs.collapse", (e) => {
            const button = e.target.previousElementSibling?.querySelector(".accordion-button");
            if (!button) return;

            const authorId = button.getAttribute("data-author-id");
            const bodyZone = document.getElementById(`author-body-${authorId}`);

            if (bodyZone && bodyZone.querySelector(".spinner-border")) {
